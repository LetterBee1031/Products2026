  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When a fire signal is received while the elevator is in operation, it
    will proceed to the evacuation floor accompanied by the announcement  \u201C\u706B\u707D\u3067\u3059\u3002\u907F\u96E3\u968E\u3078\u6B62\u307E\u308A\u307E\u3059\u3002\u201D
    (This means \u201CThere is a fire. The elevator will stop at the evacuation floor.\u201D).
    \nUpon arrival, the elevator doors will remain open for a certain period of time.
    After the fire signal is cleared, the elevator will return to normal operation.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bab06ee15b8ec9d4d9256c606e0fa7e4, type: 2}
  m_sharedMaterial: {fileID: -5615487823365657418, guid: bab06ee15b8ec9d4d9256c606e0fa7e4, type: 2}
