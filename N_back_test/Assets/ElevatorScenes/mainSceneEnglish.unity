  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When the sensor detects an earthquake while the elevator is in operation,
    the elevator will automatically travel to the nearest floor and open the doors
    for a certain period of time, accompanied by the announcement \u201C\u5730\u9707\u3067\u3059\u3002\u6700\u5BC4\u308A\u306E\u968E\u3078\u6B62\u307E\u308A\u307E\u3059\u3002\u201D
    (This means \u201CEarthquake detected. Stopping at the nearest floor.\u201D).
    \nAfter the passengers exit, the doors will close and the elevator will remain
    on standby. If the earthquake is approximately seismic intensity 4 or lower,
    the elevator will automatically resume operation after a certain period. If the
    earthquake is stronger than seismic intensity 4, the elevator will not resume
    automatically and will only return to service after a safety inspection by authorized
    personnel."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bab06ee15b8ec9d4d9256c606e0fa7e4, type: 2}
  m_sharedMaterial: {fileID: -5615487823365657418, guid: bab06ee15b8ec9d4d9256c606e0fa7e4, type: 2}
