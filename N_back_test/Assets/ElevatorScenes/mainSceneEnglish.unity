  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "If a power outage occurs while the elevator is in operation, the elevator
    will automatically travel to the nearest floor and open the doors for a certain
    period of time, accompanied by the announcement \u201C\u505C\u96FB\u3067\u3059\u3002\u6551\u51FA\u904B\u8EE2\u4E2D\u3067\u3059\u3002\u201D
    (This means \u201CPower Failure Rescue Operation in progress.\u201D). \nThe floor
    where the elevator stops is determined based on the number of passengers\u2014either
    the nearest upper floor or the nearest lower floor. The ceiling light inside
    the elevator switches to an emergency light, so it never becomes completely dark.
    Once power to the building is restored, the elevator will also resume normal
    operation."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bab06ee15b8ec9d4d9256c606e0fa7e4, type: 2}
  m_sharedMaterial: {fileID: -5615487823365657418, guid: bab06ee15b8ec9d4d9256c606e0fa7e4, type: 2}
