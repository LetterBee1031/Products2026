  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "While the elevator is in Earthquake Emergency Operation, \" \u5730\u9707\u7BA1\u5236\u904B\u8EE2
    (Earthquake Emergency Operation in Progress) \" and \" \u6700\u5BC4\u308A\u306E\u968E\u306B\u6B62\u307E\u308A\u307E\u3059
    (Stops at the Nearest Floor) \" are displayed to inform passengers that the elevator
    is in emergency operation."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bab06ee15b8ec9d4d9256c606e0fa7e4, type: 2}
