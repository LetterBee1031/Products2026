  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When a fire signal is received while the elevator is in operation, it
    will proceed to the evacuation floor accompanied by the announcement  \u201C\u706B\u707D\u3067\u3059\u3002\u907F\u96E3\u968E\u3078\u6B62\u307E\u308A\u307E\u3059\u3002\u201D
    (This means \u201CThere is a fire. The elevator will stop at the evacuation floor.\u201D).
    \n\n"
  m_isRightToLeft: 0
