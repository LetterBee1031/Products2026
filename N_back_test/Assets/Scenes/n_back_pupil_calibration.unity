      m_Calls: []
  m_text: "When the elevator arrives at the nearest floor, the doors open for a certain
    period. The floor where the elevator stops is determined based on the number
    of passengers\u2014either the nearest upper floor or the nearest lower floor.
    The ceiling light inside the elevator switches to an emergency light, so it never
    becomes completely dark. Once power to the building is restored, the elevator
    will also resume normal operation."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e8141f4f9a3a607409cb6edc4beab281, type: 2}
